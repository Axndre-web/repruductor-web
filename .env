# ==========================================
# NEON PLAYER X / NEOORB - ENTORNO REAL
# ==========================================

# 1. ENTORNO Y SERVIDOR
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_NAME="Neon Player X - NeoOrb Core"
APP_URL=https://axndre-web.github.io/repruductor-web/
LOG_LEVEL=info

# 2. IDENTIDAD Y ACCESO AUTORIZADO
AUTHORIZED_USER=steven.ax115@gmail.com
SYSTEM_CREDENTIAL_KEY=101125@Kingboss
JWT_SECRET=4f8d9a2c1e7b3a5f8d9a2c1e7b3a5f8d9a2c1e7b3a5f8d9a2c1e7b3a5f8d9a2c
SESSION_SECRET=a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7

# 3. MÓDULO ECONÓMICO Y BILLETERA SOLANA
SOLANA_WALLET_ADDRESS=CpiWyv2tyrbBqZoZMSTcVRgCGPwKgJ2jCyZ7aN1n7fSE
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
SOLANA_COMMITMENT=confirmed

# 4. PUENTE PYTHON Y LEDGER UNIFICADO (SIN SIMULACIONES)
BRIDGE_SCRIPT_PATH=./neon-lim.bridge.py
NEON_BRIDGE_PORT=3000
LEDGER_DB_NAME=neon_unified_ledger_db
ZERO_SIMULATION_MODE=true
ALLOW_MOCK_DATA=false
ENABLE_REAL_MINING=true
ENABLE_NODE_VALIDATION=true

# 5. AGENTE AUTÓNOMO Y COMANDOS DE INTENCIÓN
AGENT_AUTONOMOUS_MODE=true
AGENT_EXECUTE_INTENTS=true
LEDGER_AUTO_SYNC=true
LEDGER_SYNC_INTERVAL_MS=300000

# 6. DESPLIEGUE Y SEGURIDAD ESTRICTA
DEPLOY_TARGET=github-pages
SECURITY_POLICY=HARDENING_STRICT
CORS_ORIGIN=*
# Neon Orb live discovery (public listings only; no automatic applications or financial transfers)
NEON_DAEMON_DISCOVERY_ENABLED=true
NEON_DAEMON_INTERVAL_MS=3600000
NEON_JOB_FEED_CACHE_MS=21600000
NEON_DAEMON_AUTO_EXECUTE_ENABLED=false
NEON_EXECUTION_MODE=READ_VERIFY_ONLY
NEON_ALLOW_SPENDING=false
NEON_ALLOW_SIGNING=false
NEON_ALLOW_WITHDRAWALS=false
NEON_REQUIRE_REALITY_VERIFICATION=true
NEON_REQUIRE_AUTHORIZED_PROVIDER=true
NEON_MINING_POOL=etc
# Leave mining and BTC address empty until you provide the matching public address for the selected pool/payout asset.
NEON_MINING_WALLET_ADDRESS=
NEON_BITCOIN_ADDRESS=

# Admin bearer token generated for this package; keep .env private.
NEON_ADMIN_TOKEN=34e62e760feb56f7c5b4189c12db45155ed051c349d1bc9527eccd948c5423b8

# NEON ORB resident supervision (new settings; existing credentials/configuration above are unchanged)
NEON_AUTONOMY_TICK_MS=300000
NEON_MINING_AUTOSTART=true
# Configure these once only after installing/verifying a compatible local miner binary:
# NEON_MINER_EXECUTABLE=/absolute/path/to/approved/miner-binary
# NEON_MINER_ARGS_JSON=["-o","etc.2miners.com:1010","-u","YOUR_PUBLIC_MINING_WALLET","-p","neon"]
