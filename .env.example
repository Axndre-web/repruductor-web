# Neon Orb market + pool telemetry (read-only; no transactions signed)
NEON_MARKET_QUOTES_ENABLED=true
NEON_MARKET_DATA_PROVIDER=coinbase-spot
NEON_MINING_POOL=etc
NEON_MINING_API_PROVIDER=2miners
# Use a public wallet address for the selected mined coin, not the SOL address.
NEON_MINING_WALLET_ADDRESS=
# A miner must be installed/configured separately. The web app never launches it automatically.
NEON_MINING_AUTOSTART=false
# Optional public wallet observation
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed
# Never put private keys in browser code or commit this file with real secrets.

# Public work discovery; job listings are leads, not guaranteed paid tasks.
NEON_DAEMON_DISCOVERY_ENABLED=true
NEON_DAEMON_INTERVAL_MS=3600000
NEON_JOB_FEED_CACHE_MS=21600000
NEON_DAEMON_AUTO_EXECUTE_ENABLED=false
NEON_EXECUTION_MODE=READ_VERIFY_ONLY
NEON_ALLOW_SPENDING=false
NEON_ALLOW_SIGNING=false
NEON_ALLOW_WITHDRAWALS=false
NEON_REQUIRE_REALITY_VERIFICATION=true
NEON_REQUIRE_AUTHORIZED_PROVIDER=true
NEON_ADMIN_TOKEN=
NEON_MINING_POOL=etc
NEON_MINING_WALLET_ADDRESS=
NEON_BITCOIN_ADDRESS=


# Guarded blockchain operation policy.
# Keep disabled by default. Enabling this flag does NOT enable server-side signing/broadcasting;
# this release only exposes status + EVM gas preflight and requires an external wallet signer.
NEON_CHAIN_WRITES_ENABLED=false
NEON_EVM_CHAIN_ID=1
ETHEREUM_RPC_ENDPOINT=https://ethereum-rpc.publicnode.com
# Optional minimum ETH reserve in wei, in addition to estimated transaction value + gas margin.
NEON_EVM_MIN_RESERVE_WEI=0

# Safe network operations. No arbitrary URL fetch, redirects, remote code execution, or auto-applications.
NEON_NETWORK_TOOLS_ENABLED=true
NEON_NETWORK_REQUEST_TIMEOUT_MS=8000
NEON_NETWORK_MAX_RESPONSE_BYTES=1000000
# POST /api/neon-orb/security/audit requires a strong (32+ char) NEON_ADMIN_TOKEN.

# NEON ORB autonomous technical agent (guarded source edits, backup, fixed tests and rollback)
# Default: Ollama OpenAI-compatible endpoint on loopback. Install/run Ollama and pull a coder model.
NEON_AGENT_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
NEON_AGENT_MODEL=qwen2.5-coder:7b
# Optional for local Ollama; REQUIRED for a remote provider.
NEON_AGENT_API_KEY=
# For remote HTTPS provider only, comma-separated exact hostnames, e.g. api.example.com
NEON_AGENT_ALLOWED_HOSTS=

# Keep the UI local to this computer. Set true only for intentional protected LAN access.
NEON_ALLOW_LAN_ACCESS=false

# Wallet observation: public balances auto-sync locally when the wallet panel is open.
# Browser wallet permissions are restored silently only when the extension permits it.
NEON_WALLET_AUTO_OBSERVE=true
NEON_WALLET_OBSERVE_INTERVAL_MS=60000

# NEON ORB resident autonomy. Public research, wallet observation and telemetry run in background.
NEON_AUTONOMY_TICK_MS=300000
# Optional local mining worker: no binary is bundled. Configure once to start it on server startup.
# ENABLE_REAL_MINING=true
# NEON_MINING_AUTOSTART=true
# NEON_MINER_EXECUTABLE=/absolute/path/to/approved/miner-binary
# NEON_MINER_ARGS_JSON=["-o","etc.2miners.com:1010","-u","YOUR_PUBLIC_MINING_WALLET","-p","neon"]
# The args must include the exact NEON_MINING_WALLET_ADDRESS and the approved pool host for NEON_MINING_POOL.
# Only pre-installed allowlisted binaries are accepted; shell execution is disabled. Mining may lose money.

# Optional local Bitcoin Core RPC status. Read-only methods only; remote RPC hosts are rejected.
# Configure either user+password or a local .cookie file. Never commit real credentials.
BITCOIN_RPC_URL=http://127.0.0.1:8332/
# BITCOIN_RPC_USER=
# BITCOIN_RPC_PASSWORD=
# BITCOIN_RPC_COOKIE_FILE=/absolute/path/to/.cookie
